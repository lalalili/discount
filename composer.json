{
    "name": "lalalili/discount",
    "description": "Config-driven discount and coupon kernel for Laravel projects.",
    "type": "library",
    "license": "proprietary",
    "version": "2.5.2",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Discount\\Kernel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Discount\\Kernel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Discount\\Kernel\\DiscountServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest --compact",
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
