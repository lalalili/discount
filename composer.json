{
    "name": "lalalili/discount",
    "description": "Config-driven discount and coupon kernel for Laravel projects.",
    "type": "library",
    "license": "proprietary",
    "version": "2.5.0",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Discount\\Kernel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Discount\\Kernel\\DiscountServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress"
    }
}
